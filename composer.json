{
    "name": "vmeretail/laravel-multitenancy-kit",
    "description": "A reusable multi-tenancy foundation for Laravel: auto-provisioning, user sync, impersonation, and landlord admin panel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "spatie/laravel-multitenancy": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.2",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.3.9"
    },
    "autoload": {
        "psr-4": {
            "VmeRetail\\MultitenancyKit\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VmeRetail\\MultitenancyKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmeRetail\\MultitenancyKit\\MultitenancyKitServiceProvider",
                "VmeRetail\\MultitenancyKit\\LandlordPanelProvider"
            ]
        }
    },
    "repositories": {
        "filament": {
            "type": "composer",
            "url": "https://packages.filamentphp.com/composer"
        }
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=2G",
        "lint": [
            "./vendor/bin/pint -p",
            "./vendor/bin/rector"
        ],
        "test": [
            "@test:unit",
            "@test:lint",
            "@test:types"
        ],
        "test:lint": [
            "./vendor/bin/pint -p --test",
            "./vendor/bin/rector --dry-run"
        ],
        "test:types": "@analyse",
        "test:unit": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
