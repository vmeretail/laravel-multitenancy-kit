includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 1
    paths:
        - database
        - routes
        - src
        - tests
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    treatPhpDocTypesAsCertain: false

    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 32
        minimumNumberOfJobsPerProcess: 2
